#!/usr/bin/env bash
# meeting-notes 의 스크립트를 어느 폴더에서든 실행하는 진입점.
#
#   meeting              쓸 수 있는 명령 보기
#   meeting live         bin/live 실행
#   meeting transcribe   bin/transcribe 실행
#
# bin/setup 이 이 파일을 ~/.local/bin/meeting 으로 이어 준다.
set -eo pipefail

# 이 파일이 프로젝트 안에 있으므로 자기 위치로 폴더를 찾는다.
# 다른 곳에 복사해 두었다면 MEETING_NOTES_ROOT 로 알려 준다.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *)  SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
ROOT="${MEETING_NOTES_ROOT:-$(cd "$(dirname "$SELF")/.." && pwd)}"

if [ ! -d "$ROOT/bin" ]; then
  echo "프로젝트 폴더를 찾지 못했습니다: $ROOT" >&2
  echo "다른 곳에 두셨다면 MEETING_NOTES_ROOT 환경변수로 경로를 알려 주세요." >&2
  exit 1
fi

# 목록에 붙일 한 줄 설명. 여기에 없는 명령은 이름만 보여 준다.
describe() {
  case "$1" in
    setup)        echo "도구 설치와 .env 만들기" ;;
    prefetch)     echo "모델 미리 받기 (10GB, 오래 걸림)" ;;
    set-token)    echo "HuggingFace 토큰 넣기 (화자분리에 필요)" ;;
    setup-audio)  echo "실시간 자막용 소리 장치 만들기" ;;
    live)         echo "실시간 자막. 회의 중 상대방 말을 한국어로" ;;
    translate)    echo "영어 글을 한국어로 (예: pbpaste | meeting translate)" ;;
    import-iphone) echo "아이폰 녹음을 offline/01-inbox 로 가져오기" ;;
    transcribe)   echo "녹음을 화자별 회의록으로" ;;
    meeting_md)   echo "전사 JSON 을 회의록 마크다운으로" ;;
    selftest)     echo "스크립트를 고친 뒤 회귀 점검" ;;
    *)            echo "" ;;
  esac
}

# 목록에 이미 적어 둔 명령들. 여기에 없는 것이 bin 에 생기면 아래에서 따로 붙인다.
KNOWN="live import-iphone transcribe setup prefetch set-token setup-audio translate meeting_md selftest"

# 아직 준비되지 않은 것만 짚어 준다. 무엇부터 해야 하는지가 순서보다 먼저다.
todo=""
need() { todo="$todo$(printf '  %-24s %s' "$1" "$2")
"; }

check_ready() {
  [ -d "$HOME/.local/bin" ] && PATH="$PATH:$HOME/.local/bin"
  command -v whisperx >/dev/null 2>&1 \
    || need "meeting setup" "전사 도구가 아직 깔리지 않았습니다"
  if [ -f "$ROOT/.env" ]; then
    grep -q '^HF_TOKEN=..*' "$ROOT/.env" \
      || need "meeting set-token" "화자분리에 쓸 토큰이 비어 있습니다"
  else
    need "meeting setup" ".env 가 아직 없습니다"
  fi
  command -v whisper-stream >/dev/null 2>&1 \
    || need "brew install whisper-cpp" "실시간 전사에 필요합니다"
  ls "$ROOT"/models/ggml-*.bin >/dev/null 2>&1 \
    || need "meeting prefetch" "실시간 전사 모델이 아직 없습니다"
  command -v ollama >/dev/null 2>&1 \
    || need "brew install ollama" "실시간 번역에 필요합니다"
}

# 인자가 없을 때와 --help 는 같은 목록을 보여 준다
case "${1:-}" in
  -h|--help) set -- ;;
esac

if [ $# -eq 0 ]; then
  echo "meeting-notes: ${ROOT/#$HOME/~}"
  check_ready

  if [ -n "$todo" ]; then
    echo
    echo "▶ 먼저 할 일"
    printf '%s' "$todo"
    echo
    echo "  자세한 안내는 README.md 의 '설치' 항목에 있습니다."
  else
    echo "준비가 모두 끝났습니다. 아래 순서대로 쓰시면 됩니다."
  fi

  cat <<'TXT'

① 처음 한 번만  — 맥을 바꾸거나 새로 받았을 때만 다시 합니다
     meeting setup            도구 설치와 .env 만들기
     meeting set-token        HuggingFace 토큰 넣기 (화자분리에 필요)
     meeting prefetch         모델 미리 받기 (10GB, 오래 걸림)
     meeting setup-audio      실시간 자막용 소리 장치 만들기

② 회의 중  — 상대방 말을 한국어 자막으로 보기
     meeting live             온라인 회의. 스피커로 나오는 영어를 자막으로
     meeting live --mic       대면 회의. 마이크로 듣는 영어를 자막으로
     meeting live --ko        한국어 회의를 받아 적기만 (번역하지 않음)

   회의 시작할 때 켜 두면 됩니다. 스페이스로 멈추고 q 로 끝냅니다.
   자막은 기록용이 아닙니다. 회의록은 ③ 에서 따로 만듭니다.

③ 회의 후  — 회의록 남기기

   온라인 회의는 Anarlog 앱이 전사와 요약까지 합니다.
   내보낸 노트를 online/02-notes/ 에 두기만 하면 끝입니다.

   대면 회의는 아이폰으로 녹음한 뒤 세 단계입니다.
     1) meeting import-iphone           녹음을 offline/01-inbox 로 가져온다
     2) meeting transcribe              회의록을 만든다 (1시간 분량에 10~20분)
     3) offline/03-notes/ 의 회의록을 열어 누가 누구인지 확인하고 이름을 붙인다
        meeting transcribe 주간회의.m4a --names SPEAKER_00=이우성 SPEAKER_01=김팀장
        (전사는 다시 하지 않고 이름만 바꾸므로 몇 초면 끝납니다)

그 밖
     meeting translate        영어 글을 한국어로 (예: pbpaste | meeting translate)
     meeting meeting_md       전사 JSON 을 회의록 마크다운으로
     meeting selftest         스크립트를 고친 뒤 회귀 점검
TXT

  # 위에 적지 않은 명령이 bin 에 생겼다면 빠뜨리지 않고 덧붙인다.
  extra=""
  for f in "$ROOT"/bin/*; do
    [ -d "$f" ] && continue
    base="$(basename "$f")"; base="${base%.py}"; base="${base%.swift}"
    case "$base" in whisperx_safe|meeting) continue ;; esac
    case " $KNOWN " in *" $base "*) continue ;; esac
    extra="$extra $base"
  done
  if [ -n "$extra" ]; then
    echo
    echo "목록에 아직 적지 않은 명령"
    for base in $extra; do
      printf '     meeting %-16s %s\n' "$base" "$(describe "$base")"
    done
  fi

  echo
  echo "자세한 사용법:  meeting <명령> --help"
  echo "폴더로 이동:    cd ${ROOT/#$HOME/~}"
  exit 0
fi

cmd="$1"; shift
# meeting_md 는 파일명에 확장자가 있어 그대로도, 빼고도 받는다
for candidate in "$ROOT/bin/$cmd" "$ROOT/bin/$cmd.py"; do
  if [ -x "$candidate" ]; then
    cd "$ROOT"
    exec "$candidate" "$@"
  fi
done

# swift 스크립트는 실행 권한 대신 swift 로 태운다
if [ -f "$ROOT/bin/$cmd.swift" ]; then
  cd "$ROOT"
  exec swift "$ROOT/bin/$cmd.swift" "$@"
fi

echo "그런 명령이 없습니다: $cmd" >&2
echo "쓸 수 있는 명령을 보려면 인자 없이 'meeting' 을 실행하세요." >&2
exit 1
