#!/usr/bin/env python3
"""
클립보드에 복사해 둔 HuggingFace 토큰을 .env에 기록한다.

토큰 값은 화면에도 셸 기록에도 남지 않는다. 파이썬이 클립보드를 직접 읽어
파일에 쓰고, 앞뒤 몇 글자만 가린 형태로 확인해 준다.

사용법:
    1) https://huggingface.co/settings/tokens 에서 read 권한 토큰을 복사
    2) bin/set-token
"""

import json
import os
import stat
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
# 게이트된 저장소와, 접근 가능 여부를 판별할 실제 파일.
# 메타데이터(/api/models/...)는 동의 전에도 200을 주므로 판별에 쓸 수 없다.
GATED_REPOS = (
    ("pyannote/speaker-diarization-3.1", "config.yaml"),
    ("pyannote/segmentation-3.0", "pytorch_model.bin"),
)


def read_clipboard():
    try:
        out = subprocess.run(["pbpaste"], capture_output=True, text=True, timeout=10)
    except Exception as e:
        sys.exit(f"클립보드를 읽지 못했습니다: {e}")
    return out.stdout.strip()


def hf_get(url, token, method="GET"):
    req = urllib.request.Request(
        url, headers={"Authorization": f"Bearer {token}"}, method=method
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            if method != "GET":
                return r.status, None
            return r.status, json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        return e.code, None
    except Exception:
        return None, None


def write_env(token):
    env = ROOT / ".env"
    lines = env.read_text(encoding="utf-8").splitlines() if env.exists() else []

    for i, line in enumerate(lines):
        if line.startswith("HF_TOKEN="):
            lines[i] = f"HF_TOKEN={token}"
            break
    else:
        lines.append(f"HF_TOKEN={token}")

    env.write_text("\n".join(lines) + "\n", encoding="utf-8")
    os.chmod(env, stat.S_IRUSR | stat.S_IWUSR)  # 본인만 읽고 쓰도록 제한


def token_from_env():
    env = ROOT / ".env"
    if not env.exists():
        return None
    for line in env.read_text(encoding="utf-8").splitlines():
        if line.startswith("HF_TOKEN="):
            return line.split("=", 1)[1].strip() or None
    return None


def check_access(token):
    print("화자분리 모델 접근 확인")
    need = []
    for repo, probe_file in GATED_REPOS:
        # 가중치 파일에 실제로 닿는지 확인한다 (헤더만 요청)
        st, _ = hf_get(
            f"https://huggingface.co/{repo}/resolve/main/{probe_file}", token, method="HEAD"
        )
        if st in (200, 302):
            print(f"  [가능]      {repo}")
        elif st in (401, 403):
            print(f"  [동의 필요] {repo}")
            need.append(repo)
        else:
            print(f"  [확인 실패] {repo} (HTTP {st})")
    return need


def main():
    # --help 는 클립보드를 건드리기 전에 가로챈다
    if "--help" in sys.argv or "-h" in sys.argv:
        print(__doc__.strip())
        return

    # --check 는 클립보드를 건드리지 않고 이미 넣어 둔 토큰만 확인한다
    if "--check" in sys.argv:
        tok = token_from_env()
        if not tok:
            sys.exit(".env에 HF_TOKEN이 없습니다. 토큰을 복사한 뒤 bin/set-token 을 실행하세요.")
        st, body = hf_get("https://huggingface.co/api/whoami-v2", tok)
        if st != 200:
            sys.exit(f"저장된 토큰이 유효하지 않습니다 (HTTP {st}).")
        print(f"계정 확인: {body.get('name')}\n")
        need = check_access(tok)
        if need:
            print("\n아래 페이지에서 약관에 동의해 주세요.")
            for repo in need:
                print(f"  https://huggingface.co/{repo}")
        else:
            print("\n모두 접근 가능합니다.")
        return

    token = read_clipboard()
    if not token:
        sys.exit("클립보드가 비어 있습니다. 토큰을 복사한 뒤 다시 실행해 주세요.")
    if "\n" in token or " " in token:
        sys.exit("클립보드에 줄바꿈이나 공백이 섞여 있습니다. 토큰만 복사해 주세요.")

    masked = f"{token[:4]}…{token[-4:]}" if len(token) > 12 else "(짧음)"
    print(f"클립보드 내용: {masked} ({len(token)}자)")

    # 형식을 추측하지 않고 HuggingFace에 직접 물어본다
    status, body = hf_get("https://huggingface.co/api/whoami-v2", token)
    if status == 401:
        sys.exit(
            "이 값은 HuggingFace 토큰이 아니거나 만료되었습니다.\n"
            "  https://huggingface.co/settings/tokens 에서 read 권한 토큰을 새로 만들어 복사해 주세요."
        )
    if status is None:
        sys.exit("HuggingFace에 연결하지 못했습니다. 네트워크를 확인해 주세요.")
    if status != 200:
        sys.exit(f"확인에 실패했습니다 (HTTP {status}).")

    name = body.get("name", "알 수 없음")
    print(f"계정 확인: {name}")

    write_env(token)
    print(".env에 기록했습니다 (권한 600으로 제한).")

    print()
    need_consent = check_access(token)

    if need_consent:
        print("\n아래 페이지에서 약관에 동의한 뒤 다시 실행하면 확인됩니다.")
        for repo in need_consent:
            print(f"  https://huggingface.co/{repo}")
    else:
        print("\n준비가 끝났습니다. 이제 bin/transcribe 를 쓰실 수 있습니다.")


if __name__ == "__main__":
    main()
