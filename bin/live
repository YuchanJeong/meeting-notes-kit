#!/usr/bin/env bash
# 실시간 자막: 소리 → 전사 → 번역 → 화면
#
#   bin/live                     온라인 회의 (BlackHole로 들어오는 상대방 목소리)
#   bin/live --mic               대면 회의, 영어 발화 (맥북 마이크)
#   bin/live --ko                맥북 마이크, 한국어 회의 - 전사만 하고 번역하지 않는다
#   bin/live --backend claude-cli
#   bin/live --context "릴스 마케팅 회의"
#   bin/live --no-save           자막을 파일로 남기지 않는다
#   bin/live --no-source         원문을 감추고 번역만 본다
#   bin/live --keep-audio        소리 출력을 건드리지 않는다
#   bin/live --terminal          창을 띄우지 않고 터미널에 흘린다
#
# 돌아가는 중에 스페이스로 멈추고 이어 갈 수 있고, q 로 끝내면 자막이 파일로 남는다.
set -eo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -f "$ROOT/.env" ]; then
  set -a; . "$ROOT/.env"; set +a
fi

MODEL="${LIVE_MODEL:-medium.en}"
BACKEND="${TRANSLATE_BACKEND:-ollama}"
SOURCE="blackhole"
CONTEXT=""
NO_SOURCE=""
NO_SAVE=""
WINDOW=1
KEEP_AUDIO=0
LANG="en"
TRANSLATE=1

while [ $# -gt 0 ]; do
  case "$1" in
    --mic)       SOURCE="mic"; shift ;;
    --ko|--korean)
                 SOURCE="mic"; LANG="ko"; TRANSLATE=0
                 MODEL="${LIVE_MODEL_KO:-medium}"   # 한국어는 다국어 모델이라야 한다
                 shift ;;
    --backend)   BACKEND="$2"; shift 2 ;;
    --model)     MODEL="$2"; shift 2 ;;
    --context)   CONTEXT="$2"; shift 2 ;;
    --no-source) NO_SOURCE="--no-source"; shift ;;
    --no-save)   NO_SAVE="--no-save"; shift ;;
    --window)    WINDOW=1; shift ;;
    --terminal)  WINDOW=0; shift ;;
    --keep-audio)  KEEP_AUDIO=1; shift ;;
    -h|--help)   sed -n '2,/^[^#]/p' "$0" | sed -n 's/^# \{0,1\}//p'; exit 0 ;;
    *)           echo "모르는 인자: $1" >&2; exit 1 ;;
  esac
done

command -v whisper-stream >/dev/null 2>&1 || {
  echo "whisper-stream 이 없습니다. 'brew install whisper-cpp' 로 설치해 주세요." >&2
  exit 1
}

MODEL_PATH="$ROOT/models/ggml-$MODEL.bin"
# 모델별로 알려진 최소 크기. 이보다 작으면 아직 받는 중이거나 깨진 파일이다.
model_min_bytes() {
  case "$1" in
    tiny*)   echo 70000000 ;;
    base*)   echo 140000000 ;;
    small*)  echo 460000000 ;;
    medium*) echo 1400000000 ;;
    large*)  echo 2900000000 ;;
    *)       echo 1 ;;
  esac
}

model_ready() {
  local f="$1" name="$2"
  [ -f "$f" ] || return 1
  local size; size=$(wc -c < "$f" 2>/dev/null | tr -d ' ')
  [ "${size:-0}" -ge "$(model_min_bytes "$name")" ]
}

if ! model_ready "$MODEL_PATH" "$MODEL"; then
  if [ -f "$MODEL_PATH" ]; then
    echo "참고: $MODEL 은 아직 받는 중입니다 ($(du -h "$MODEL_PATH" | cut -f1))." >&2
  fi
fi

if ! model_ready "$MODEL_PATH" "$MODEL"; then
  # 원하는 모델이 아직 없으면, 받아 둔 것 중 가장 정확한 쪽으로 물러선다
  for alt in medium.en small.en base.en; do
    [ "$LANG" = "ko" ] && alt="${alt%.en}"
    if model_ready "$ROOT/models/ggml-$alt.bin" "$alt"; then
      echo "         $alt 로 돌립니다." >&2
      MODEL="$alt"; MODEL_PATH="$ROOT/models/ggml-$alt.bin"
      break
    fi
  done
fi

model_ready "$MODEL_PATH" "$MODEL" || {
  echo "전사 모델이 없습니다: $MODEL_PATH" >&2
  if [ "$LANG" = "ko" ]; then
    echo "  한국어에는 다국어 모델이 필요합니다. 아래로 받으세요." >&2
    echo "    curl -L -o '$MODEL_PATH' https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-$MODEL.bin" >&2
  else
    echo "  bin/prefetch 로 받을 수 있습니다." >&2
  fi
  exit 1
}

# 캡처 장치를 이름으로 찾는다. 장치 번호는 연결 상황에 따라 바뀐다.
if [ "$SOURCE" = "mic" ]; then
  WANT="MacBook Pro 마이크"
else
  WANT="BlackHole"
fi

# 장치 목록만 보려는 것이므로 가장 가벼운 모델로 묻는다.
# 큰 모델로 물으면 목록이 나오기 전에 모델 적재로 시간이 다 간다.
PROBE_MODEL="$MODEL_PATH"
for probe in base.en small.en; do
  if [ -s "$ROOT/models/ggml-$probe.bin" ]; then
    PROBE_MODEL="$ROOT/models/ggml-$probe.bin"
    break
  fi
done

DEVICE_LIST="$(timeout 60 whisper-stream -m "$PROBE_MODEL" -c 999 2>&1 | grep "Capture device #" || true)"
CAPTURE="$(printf '%s\n' "$DEVICE_LIST" | grep -i "$WANT" | head -1 | sed -E 's/.*#([0-9]+):.*/\1/')"

if [ -z "$CAPTURE" ]; then
  echo "소리를 받을 장치를 찾지 못했습니다: $WANT" >&2
  if [ -n "$DEVICE_LIST" ]; then
    echo "  이 맥에 있는 장치는 이렇습니다:" >&2
    printf '%s\n' "$DEVICE_LIST" | sed 's/^/  /' >&2
  else
    echo "  장치 목록 자체를 가져오지 못했습니다. whisper-stream 이 제대로 깔렸는지 확인해 주세요." >&2
  fi
  [ "$SOURCE" = "blackhole" ] && echo "  BlackHole 이 없다면 'brew install blackhole-2ch' 가 필요합니다." >&2
  exit 1
fi

# 온라인 회의는 시스템 오디오를 거쳐야 상대방 목소리가 잡힌다.
# 매번 손으로 바꾸기 번거로우니 여기서 잡고, 끝나면 쓰던 출력으로 돌려 놓는다.
PREV_AUDIO_UID=""
restore_audio() {
  if [ -n "$PREV_AUDIO_UID" ]; then
    timeout 60 swift "$ROOT/bin/setup-audio.swift" --use-uid "$PREV_AUDIO_UID" >/dev/null 2>&1
    echo "소리 출력을 원래대로 되돌렸습니다." >&2
    PREV_AUDIO_UID=""
  fi
}

if [ "$SOURCE" = "blackhole" ] && [ "$KEEP_AUDIO" = "0" ]; then
  CURRENT="$(timeout 60 swift "$ROOT/bin/setup-audio.swift" --status 2>/dev/null | sed 's/^현재 시스템 출력: //')"
  case "$CURRENT" in
    *BlackHole*|*"회의 출력"*)
      ;;   # 이미 잡혀 있다
    *)
      PREV_AUDIO_UID="$(timeout 60 swift "$ROOT/bin/setup-audio.swift" --status-uid 2>/dev/null | tr -d '\n')"
      if timeout 60 swift "$ROOT/bin/setup-audio.swift" --use >/dev/null 2>&1; then
        echo "소리 출력을 '회의 출력' 으로 바꿨습니다 (끝나면 '$CURRENT' 로 되돌립니다)." >&2
      else
        PREV_AUDIO_UID=""
        echo "주의: 출력을 바꾸지 못했습니다. 상대방 목소리가 안 잡힐 수 있습니다." >&2
      fi
      ;;
  esac
fi

echo "─────────────────────────────────────────────"
echo " 실시간 자막"
echo "   소리   : $WANT (장치 #$CAPTURE)"
echo "   전사   : $MODEL / $LANG (Metal GPU)"
if [ "$TRANSLATE" = "1" ]; then
  echo "   번역   : $BACKEND"
else
  echo "   번역   : 하지 않음 (한국어 전사만)"
fi
[ -n "$CONTEXT" ] && echo "   맥락   : $CONTEXT"
if [ "$WINDOW" = "1" ]; then
  echo "   화면   : 자막 창 (창에서 크게·작게, 투명도, 글자 크기를 고칩니다)"
else
  echo "   화면   : 터미널"
fi
echo "   조작   : 스페이스=멈춤·재개  q=끝내기"
echo "─────────────────────────────────────────────"

ERRLOG="$(mktemp -t meeting-live)"
cleanup() {
  restore_audio
  # 자막이 한 줄도 없이 끝났다면 전사기가 죽은 것이다. 그 이유를 보여 준다.
  if [ -s "$ERRLOG" ] && grep -qiE "error|failed|invalid|cannot|unable" "$ERRLOG"; then
    echo "" >&2
    echo "전사기가 멈췄습니다:" >&2
    grep -iE "error|failed|invalid|cannot|unable" "$ERRLOG" | head -3 | sed 's/^/  /' >&2
  fi
  rm -f "$ERRLOG"
}
trap cleanup EXIT

SUBTITLE_SRC="$ROOT/bin/subtitle.swift"
SUBTITLE_BIN="$ROOT/.build/subtitle"
if [ "$WINDOW" = "1" ]; then
  if [ ! -x "$SUBTITLE_BIN" ] || [ "$SUBTITLE_SRC" -nt "$SUBTITLE_BIN" ]; then
    mkdir -p "$ROOT/.build"
    echo "자막 창을 준비합니다 (처음 한 번만, 10초쯤 걸립니다)…" >&2
    if ! swiftc -O "$SUBTITLE_SRC" -o "$SUBTITLE_BIN" 2>/dev/null; then
      echo "자막 창을 만들지 못했습니다. 터미널에 흘립니다." >&2
      WINDOW=0
    fi
  fi
fi

TRANSLATE_ARGS=(--backend "$BACKEND")
[ -n "$CONTEXT" ] && TRANSLATE_ARGS+=(--context "$CONTEXT")
[ -n "$NO_SOURCE" ] && TRANSLATE_ARGS+=("$NO_SOURCE")
[ -n "$NO_SAVE" ] && TRANSLATE_ARGS+=("$NO_SAVE")
[ "$TRANSLATE" = "0" ] && TRANSLATE_ARGS+=(--no-translate)
[ "$WINDOW" = "1" ] && TRANSLATE_ARGS+=(--window)

# --step 0 은 음성 활동 감지(VAD) 모드다. 발화가 끝날 때마다 한 덩어리로 내보내므로
# 고정 간격으로 자르는 것보다 문장이 온전하고, 번역 품질이 낫다.
whisper-stream \
    -m "$MODEL_PATH" \
    -c "$CAPTURE" \
    --step 0 --length 8000 -vth 0.6 -bs 5 -mt 64 \
    -l "$LANG" -t 8 2>"$ERRLOG" \
  | grep --line-buffered -vE '^(init|whisper_|main:|ggml_|load_|\[Start|\[2K|### )' \
  | sed -u -E 's/\x1b\[[0-9;]*[A-Za-z]//g; s/^\[[0-9:.]+ --> [0-9:.]+\][[:space:]]*//' \
  | grep --line-buffered -vE '^[[:space:]]*(\[[A-Z_]+\])?[[:space:]]*$' \
  | grep --line-buffered -viE '^[[:space:]]*(\(.*\)|\[.*\])[[:space:]]*$' \
  | grep --line-buffered -viE '^[[:space:]]*(thank you|thanks for watching|you|bye|\.|,)[[:space:]]*[.!]?[[:space:]]*$' \
  | "$ROOT/bin/translate" "${TRANSLATE_ARGS[@]}" \
  | { if [ "$WINDOW" = "1" ]; then "$SUBTITLE_BIN"; else cat; fi; }
