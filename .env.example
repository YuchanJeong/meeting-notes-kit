# HuggingFace 토큰 (read 권한). 화자분리 모델을 내려받는 데 필요합니다.
# meeting set-token 을 쓰면 클립보드에서 바로 넣어 줍니다.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# --- 사후 처리 (meeting transcribe) ---
# 전사 모델과 언어. 속도가 급하면 large-v3 대신 medium을 써도 됩니다.
WHISPER_MODEL=large-v3
WHISPER_LANG=ko

# --- 실시간 자막 (meeting live) ---
# 실시간 전사 모델. 영어 전용이 같은 크기의 다국어 모델보다 빠르고 정확합니다.
LIVE_MODEL=medium.en
# --ko 로 한국어 회의를 전사할 때 쓸 모델. 다국어 모델이라야 합니다.
LIVE_MODEL_KO=medium
# 번역 백엔드: ollama(기본, 무료) / claude-cli(구독) / claude(API 키)
TRANSLATE_BACKEND=ollama
# ollama 백엔드가 쓸 모델
OLLAMA_MODEL=exaone3.5:7.8b

# claude 백엔드를 쓸 때만 필요합니다. claude-cli 는 키가 없어도 됩니다.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5
